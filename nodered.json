  {"id":"fn-cmd-ts","type":"function","z":"flow-sim","name":"Timestamp","func":"msg.payload.timestamp=new Date().toISOString();\nmsg.payload=JSON.stringify(msg.payload);\nmsg.qos=1;msg.retain=false;\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":350,"y":450,"wires":[["mqtt-out-cmd"]]},
