  {"id":"mqtt-in-cmd","type":"mqtt in","z":"flow-sim","name":"Sub Comandos","topic":"casa/+/+/comando","qos":"1","datatype":"auto","broker":"cfg-mqtt-01","nl":false,"rap":true,"rh":0,"inputs":0,"x":130,"y":660,"wires":[["fn-dev-sim"]]},
  {"id":"fn-dev-sim","type":"function","z":"flow-sim","name":"Simulador Dispositivo","func":"var data;\ntry{data=(typeof msg.payload==='string')?JSON.parse(msg.payload):msg.payload;}catch(e){return null;}\nvar parts=msg.topic.split('/'),room=parts[1],dev=parts[2];\nvar resp={dispositivo:data.dispositivo,estado:data.comando==='LIGAR'?'ON':'OFF',confirmado_em:new Date().toISOString(),latencia_ms:Math.round(Math.random()*50+10)};\nnode.status({fill:resp.estado==='ON'?'green':'red',shape:'dot',text:data.dispositivo+': '+resp.estado});\nmsg.topic='casa/'+room+'/'+dev+'/estado';\nmsg.payload=JSON.stringify(resp);msg.qos=1;msg.retain=true;\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":370,"y":660,"wires":[["mqtt-out-estado"]]},
  {"id":"mqtt-out-estado","type":"mqtt out","z":"flow-sim","name":"Pub Estado","topic":"","qos":"1","retain":"true","broker":"cfg-mqtt-01","x":590,"y":660,"wires":[]},

  {"id":"mqtt-in-dash","type":"mqtt in","z":"flow-dash","name":"Sub casa/#","topic":"casa/#","qos":"2","datatype":"auto","broker":"cfg-mqtt-01","nl":false,"rap":true,"rh":0,"inputs":0,"x":120,"y":300,"wires":[["fn-dash-router"]]},
  {"id":"fn-dash-router","type":"function","z":"flow-dash","name":"Dashboard Router","outputs":11,"func":"var topic=msg.topic;\nvar data;\ntry{data=(typeof msg.payload==='string')?JSON.parse(msg.payload):msg.payload;}catch(e){return null;}\nvar v=data.valor;\nvar out=[null,null,null,null,null,null,null,null,null,null,null];\nif(topic==='casa/sala/temperatura')         out[0]={payload:v,topic:'Sala'};\nelse if(topic==='casa/sala/umidade')        out[1]={payload:v};\nelse if(topic==='casa/sala/luminosidade')   out[2]={payload:v+' lux'};\nelse if(topic==='casa/quarto/temperatura')  out[3]={payload:v,topic:'Quarto'};\nelse if(topic==='casa/quarto/umidade')      out[4]={payload:v};\nelse if(topic==='casa/quarto/presenca')     out[5]={payload:v===1?'Presente ✅':'Ausente ⬜'};\nelse if(topic==='casa/cozinha/temperatura') out[6]={payload:v,topic:'Cozinha'};\nelse if(topic==='casa/cozinha/umidade')     out[7]={payload:v};\nelse if(topic==='casa/cozinha/gas')         out[8]={payload:v===1?'⚠️ GÁS DETECTADO!':'✅ Normal'};\nelse if(topic==='casa/alertas')             out[9]={payload:(data.nivel||'')+': '+(data.mensagem||'')};\nelse if(topic==='casa/quarto/luminosidade') out[10]={payload:v+' lux'};\nreturn out;","noerr":0,"initialize":"","finalize":"","libs":[],"x":360,"y":300,"wires":[["gauge-sala-temp","chart-sala-temp"],["gauge-sala-hum"],["text-sala-lux"],["gauge-quarto-temp","chart-quarto-temp"],["gauge-quarto-hum"],["text-quarto-pres"],["gauge-coz-temp","chart-coz-temp"],["gauge-coz-hum"],["text-coz-gas"],["text-alerta"],["text-quarto-lux"]]},

