  {"id":"inj-sala","type":"inject","z":"flow-sim","name":"Timer Sala 5s","props":[{"p":"payload"}],"repeat":"5","crontab":"","once":true,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":130,"y":80,"wires":[["fn-sala"]]},
  {"id":"fn-sala","type":"function","z":"flow-sim","name":"Gera Sala","func":"var now=new Date(),ts=now.toISOString(),dev='sala_sensor_01';\nvar temp=Math.round((22+Math.sin(now.getMinutes()/10)*4+(Math.random()*2-1))*10)/10;\nvar hum=Math.round((55+Math.random()*20-10)*10)/10;\nvar lux=Math.round(300+Math.random()*400);\nreturn [[{topic:'casa/sala/temperatura',payload:JSON.stringify({dispositivo:dev,valor:temp,unidade:'°C',timestamp:ts}),qos:0,retain:false},{topic:'casa/sala/umidade',payload:JSON.stringify({dispositivo:dev,valor:hum,unidade:'%',timestamp:ts}),qos:0,retain:false},{topic:'casa/sala/luminosidade',payload:JSON.stringify({dispositivo:dev,valor:lux,unidade:'lux',timestamp:ts}),qos:0,retain:false}]];","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":300,"y":80,"wires":[["mqtt-out-sim"]]},
  {"id":"inj-quarto","type":"inject","z":"flow-sim","name":"Timer Quarto 7s","props":[{"p":"payload"}],"repeat":"7","crontab":"","once":true,"onceDelay":0.5,"topic":"","payload":"","payloadType":"date","x":130,"y":160,"wires":[["fn-quarto"]]},
  {"id":"fn-quarto","type":"function","z":"flow-sim","name":"Gera Quarto","func":"var now=new Date(),ts=now.toISOString(),dev='quarto_sensor_01';\nvar temp=Math.round((20+Math.random()*4-1)*10)/10;\nvar hum=Math.round((50+Math.random()*20-10)*10)/10;\nvar lux=Math.round(100+Math.random()*200);\nvar pres=Math.random()>0.4?1:0;\nreturn [[{topic:'casa/quarto/temperatura',payload:JSON.stringify({dispositivo:dev,valor:temp,unidade:'°C',timestamp:ts}),qos:0,retain:false},{topic:'casa/quarto/umidade',payload:JSON.stringify({dispositivo:dev,valor:hum,unidade:'%',timestamp:ts}),qos:0,retain:false},{topic:'casa/quarto/luminosidade',payload:JSON.stringify({dispositivo:dev,valor:lux,unidade:'lux',timestamp:ts}),qos:0,retain:false},{topic:'casa/quarto/presenca',payload:JSON.stringify({dispositivo:dev,valor:pres,unidade:'bool',timestamp:ts}),qos:1,retain:true}]];","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":300,"y":160,"wires":[["mqtt-out-sim"]]},
  {"id":"inj-cozinha","type":"inject","z":"flow-sim","name":"Timer Cozinha 10s","props":[{"p":"payload"}],"repeat":"10","crontab":"","once":true,"onceDelay":1,"topic":"","payload":"","payloadType":"date","x":130,"y":240,"wires":[["fn-cozinha"]]},
  {"id":"fn-cozinha","type":"function","z":"flow-sim","name":"Gera Cozinha","func":"var now=new Date(),ts=now.toISOString(),dev='cozinha_sensor_01';\nvar temp=Math.round((24+Math.random()*8)*10)/10;\nvar hum=Math.round((60+Math.random()*25)*10)/10;\nvar gas=Math.random()>0.95?1:0;\nreturn [[{topic:'casa/cozinha/temperatura',payload:JSON.stringify({dispositivo:dev,valor:temp,unidade:'°C',timestamp:ts}),qos:0,retain:false},{topic:'casa/cozinha/umidade',payload:JSON.stringify({dispositivo:dev,valor:hum,unidade:'%',timestamp:ts}),qos:0,retain:false},{topic:'casa/cozinha/gas',payload:JSON.stringify({dispositivo:dev,valor:gas,unidade:'bool',timestamp:ts}),qos:2,retain:false}]];","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":300,"y":240,"wires":[["mqtt-out-sim"]]},
